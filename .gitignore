# .claude/ is tracked on purpose. settings.json, hooks/ and skills/ encode this
# repo's rules -- the generated files nobody should hand-edit, the branches
# pre-commit refuses a commit on, and the release procedure whose one manual
# step is easy to miss -- so they belong to the repo, not to one machine.
# Two paths inside it do not: settings.local.json is per-developer overrides,
# and format.log is the formatter hook's own record of tools it could not find.
.claude/settings.local.json
.claude/hooks/format.log

# deploy/README.md's first boot step is `cp .env.example .env` *inside this
# working tree*, and that file holds DB_ROOT_PASSWORD and ADMIN_PASSWORD. This
# repository is public: one `git add -A` on a deploy host would publish a
# production database password. .env.example stays tracked; .env never is.
.env
deploy/.env
# Local container scratch: the Chrome installer used to provision Playwright's
# browser, and the devcontainer lockfile the CLI regenerates per rebuild.
google-chrome-stable_current_amd64.deb
.devcontainer/devcontainer-lock.json

# Rotating .env keeps the superseded credentials in the working tree, one
# `git add -A` away from being published; and an override file is by definition
# one host's paths, ports and hardware, which nobody else can use.
deploy/.env.bak-*
deploy/docker-compose.override.yml

# scripts/init.sh tees its output here so a failed devcontainer provision can be
# read after the Dev Containers terminal has scrolled away.
.devcontainer/init.log

# The devcontainer builds its bench on a named docker volume, not in the tree.
# This stays as a backstop: a `bench init` run by hand from the repo root, or an
# older container, still lands ~1.5GB of apps/, env/ and sites/ right here.
/frappe-bench/
