# Production override for the vectora.absolute-insight.ai stack on this host.
#
# 1. Pins every app service to the v3.8.1 release (manifest verified in ghcr
#    on 2026-09-02). .env is meant to stay one release behind — it names the
#    version someone rolls back to by deleting this file and `up -d`. That
#    invariant holds again: .env names v3.7.0, the previous released image,
#    and this file carries v3.8.1; deleting it and running `up -d` rolls back.
#
#
# 2. Attaches the frontend to sim-caddy's network under the alias `vectora` —
#    the Caddyfile's `reverse_proxy vectora:8080` for vectora.absolute-insight.ai
#    resolves through it. This attachment previously lived only on the running
#    container (its declaring override file had been deleted), so the first
#    `docker compose up -d` recreated frontend without it and the public site
#    502'd. Declared here, it survives every future recreation.
networks:
  sim-net:
    external: true
    name: sim-prod_sim-net

services:
  configurator: { image: "ghcr.io/absolute-insight/simcrm:v3.13.1" }
  create-site: { image: "ghcr.io/absolute-insight/simcrm:v3.13.1" }
  backend: { image: "ghcr.io/absolute-insight/simcrm:v3.13.1" }
  websocket: { image: "ghcr.io/absolute-insight/simcrm:v3.13.1" }
  frontend:
    image: "ghcr.io/absolute-insight/simcrm:v3.13.1"
    networks:
      default: {}
      sim-net:
        aliases: [vectora]
  queue-short: { image: "ghcr.io/absolute-insight/simcrm:v3.13.1" }
  queue-long: { image: "ghcr.io/absolute-insight/simcrm:v3.13.1" }
  scheduler: { image: "ghcr.io/absolute-insight/simcrm:v3.13.1" }
  backup: { image: "ghcr.io/absolute-insight/simcrm:v3.13.1" }
