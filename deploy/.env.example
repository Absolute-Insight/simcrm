# Copy to .env beside docker-compose.yml and fill in the secrets.
# Nothing here has a workable default on purpose: a stack that boots with
# guessable credentials is worse than one that refuses to boot.

# The image builds.yml publishes. Three kinds of tag are available:
#
#   v3.2.1      a release. Immutable, because the git tag is. Use this.
#   sha-abc1234 one exact commit. Immutable. Use when running something that
#               is not a release, e.g. verifying a fix before it ships.
#   stable      a moving pointer to the newest main build. Convenient for a
#               scratch environment, wrong for anything a customer touches:
#               two `docker compose pull`s a week apart give you materially
#               different systems and no way to say which one broke.
#
# Required: docker-compose.yml has no default for VECTORA_TAG, so a stack
# cannot drift onto `stable` by omission. Set a release and bump it when you
# upgrade, so the file records what is running.
#
# Check the tag actually has an image before pinning it -- a GitHub release and
# a published image are two separate steps, and v3.2.0 shipped as the first
# without the second. docs/RELEASING.md explains why and how to confirm.
VECTORA_IMAGE=ghcr.io/absolute-insight/simcrm
VECTORA_TAG=v3.30.0

# The site name is also the Host header nginx routes on. Use the real domain.
SITE_NAME=crm.example.com

# The public URL, scheme included. Frappe builds the absolute links it emails
# -- password resets, invitations, share links -- from this when it is set, and
# from the Host header of the triggering request when it is not, so without it
# those links say whatever the request said. Optional and unset by default:
# unset, nothing is written and a host_name already in the site's config is
# left alone. Set, it is written to site_config on every `up -d`. Either way
# the proxy in front must refuse Host headers that are not yours -- see
# README.md, "host_name, and the Host header".
#SITE_HOST_NAME=https://crm.example.com

DB_ROOT_PASSWORD=
ADMIN_PASSWORD=

# --- Database sizing --------------------------------------------------------
# InnoDB's buffer pool, and the memory ceiling of the container it lives in.
# Keep the pool at or below about half of the limit: the pool is not all that
# MariaDB allocates, and the kernel kills a container that reaches its limit.
# Changing either recreates the db container on the next `up -d` -- a cold
# restart of the database, so do it in a maintenance window. No data changes.
# README.md, "Sizing the database", says what to measure before raising them.
#DB_INNODB_BUFFER_POOL_SIZE=384M
#DB_MEMORY_LIMIT=1g

# Where the frontend listens on the host. Put TLS in front of this — see
# README.md; this stack deliberately does not terminate TLS itself.
#
# The port is bound to loopback by default, so only a reverse proxy on the
# same host can reach it. Set HTTP_BIND_ADDRESS=0.0.0.0 only when the proxy
# (or, for a rehearsal, you) is on another machine — then the plain-HTTP
# frappe port is open to whatever can route to the host, firewall included.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PUBLISH_PORT=8080

# --- Local model (optional) --------------------------------------------------
# Only used by the `local-model` compose profile:
#   docker compose --profile local-model up -d
# Without the profile none of this applies and the agent tier talks to whatever
# remote OpenAI-compatible endpoint you configure in CRM Agent Settings — or to
# nothing at all, which is the default and a supported state.

# LFM2.5-2.6B is the model this stack is verified against. Eleven models were
# run through the real client on the injection corpus; this is the only one
# that refused to draft the fraudulent discount (0/7, where every Apache
# candidate confirmed it 7/7). Guided decoding is clean and a warm summary
# returns in ~2.8s on a small GPU.
#
# ⚠ LICENCE: LFM2.5-2.6B ships under LFM1.0, not Apache. Commercial use is
# limited above "annual revenue of 10 million United States dollars". If your
# organisation is above that line, do not run this default -- buy a commercial
# licence from Liquid AI, or move to hardware that can host a larger
# permissively-licensed model. See deploy/README.md, "The model licence, and
# who it binds", for the two supported ways through.
#
# Do not use InternScience/Agents-A1-4B: it connects fine and returns empty
# content, which the agent correctly reports as "unavailable".
#
# Do not use openbmb/MiniCPM5-2B or MiniCPM5-1B either, and not for that reason
# -- both load on this profile and answer quickly (the 2B in 0.7s with
# reasoning off, against the default's 3.3s). They take the planted instruction:
# on the injection corpus the 2B lands 3 of 4 cases with every control arm
# clean, and the 1B confirms the fraudulent 90% discount 3 of 3. The 1B was
# previously listed above for returning empty content; that was the old
# 1024-token budget, not the model. Checked 2026-09-08.
#
# XHToken/Spark-X2.5-4B (Apache-2.0, and otherwise a real candidate) cannot be
# served by this profile at all: ollama pulls it and the first call dies with
# `unknown model architecture: 'spark2_5'`. Checked 2026-09-08; the ollama
# support PR was still open. Do not set it here expecting it to work.
VECTORA_AGENT_MODEL=hf.co/LiquidAI/LFM2.5-2.6B-GGUF:Q4_K_M

# Set to 1 when you bring the profile up, and the site is created with the
# assistant already switched on and pointed at the ollama container. Left at 0
# the tier ships off — the endpoint is still configured, so an admin turning it
# on in Settings -> Assistant has nothing else to fill in.
#
# Both are read exactly once, by after_install when the site is created. They
# do nothing on an existing site: change the endpoint in Settings instead, or
# the deployment would quietly revert an admin's choice on every upgrade.
VECTORA_AGENT_ENABLED=0

# Where the assistant looks for an OpenAI-compatible endpoint. The default is
# the ollama service in this file; point it at your own server (including a
# hosted one) to use that instead, with or without the local-model profile.
VECTORA_AGENT_BASE_URL=http://ollama:11434/v1

# How long ollama keeps weights resident. Short values mean the first rep after
# a quiet period waits for a reload — measured at ~9.5s cold against ~1s warm,
# so this is the difference between "instant" and "did it break?".
OLLAMA_KEEP_ALIVE=24h

# The address range nginx trusts to carry the real client IP in
# X-Forwarded-For. The default covers Docker's private networks, which is where
# a reverse proxy on this host arrives from; set your proxy's address if it
# sits elsewhere. Wrong, and every user shares one rate-limit bucket.
#UPSTREAM_REAL_IP_ADDRESS=172.16.0.0/12

# --- Backups ---------------------------------------------------------------
# The `backup` service takes one every night and prunes to a week (the site's
# keep_backups_for_hours, set to 168 by create-site).

# Hour of the day it runs, container local time.
#BACKUP_HOUR=2

# The `backup` container reports unhealthy when the newest database dump is
# older than this many hours -- one nightly run plus slack. A whole number;
# anything else is ignored and 26 is used. README.md, "Knowing when a backup
# did not happen".
#BACKUP_MAX_AGE_HOURS=26

# A dead-man's switch for the nightly run: a healthchecks.io check URL (or any
# service with its protocol -- README.md, "Being told when a backup did not
# happen"). The service GETs <url>/start, then <url> or <url>/fail; the
# monitor alerts when the success ping does not arrive. Set the check's period
# to 1 day and its grace to a few hours. Optional; unset sends nothing. The
# path of the URL is the secret: it is never logged past the host.
#BACKUP_PING_URL=https://hc-ping.com/<uuid>

# --- Off-host copies (the `offsite` profile) --------------------------------
# A backup that only exists on the host it protects survives a bad delete, not
# a lost server -- and losing the server is the case a customer actually fears.
# The `backup-offsite` service copies the nightly dumps to Backblaze B2 hourly,
# and the first backup of each month once more under monthly/.
#
# It only runs when you ask for it:
#
#   docker compose --profile offsite up -d
#
# Set the bucket up first -- README.md, "Immutable copies, and how long they
# are kept": Object Lock on, lifecycle rules for the dailies and the
# monthlies, and an *application key* scoped to that one bucket that can
# write but NOT delete (listBuckets, listFiles, readFiles, writeFiles).
#B2_ACCOUNT_ID=00••••••••••••••••••••••••
#B2_APPLICATION_KEY=K00••••••••••••••••••••••••••••

# The bucket, as an rclone destination. The site name is appended
# automatically, so one bucket can hold several deployments.
#BACKUP_TARGET=offsite:vecmbp

# Anything rclone speaks, if you are not on Backblaze: s3, sftp, azureblob...
#OFFSITE_TYPE=b2

# Client-side encryption. SET THIS before the first copy: every copy then goes
# through an rclone `crypt` remote and the bucket holds only ciphertext, under
# <site>.crypt/ and monthly/<site>.crypt/. Left empty, the dailies still go,
# unencrypted, to <site>/ as they always have -- but every run logs a warning,
# the container reports unhealthy, and there is no monthly tier, until it is
# set or OFFSITE_ALLOW_PLAINTEXT=1 says plaintext is a decision.
#
# Generate both with `openssl rand -base64 32`. They are the ONLY way to read
# the archive, and the archive exists for the day this host is gone, so before
# the first copy:
#   - put both in the team's password manager, and
#   - give a sealed paper copy to a second person, kept away from this host.
# Losing them loses every backup; changing them later makes the existing
# encrypted copies unreadable under the new values. (On this host they are in
# the clear here and in `docker inspect`; they protect the bucket, not the
# machine.) README.md, "Encrypting the copies".
OFFSITE_CRYPT_PASSWORD=
# The crypt salt (rclone's password2). Optional but recommended; same rules.
OFFSITE_CRYPT_SALT=

# Accept unencrypted copies: the per-run warning stays, the healthcheck stops
# reporting it, and the monthly tier runs unencrypted too. Only for a
# destination you control end to end.
#OFFSITE_ALLOW_PLAINTEXT=0

# What is NOT copied unless the copies are encrypted: the
# `*-site_config_backup.json` beside each dump. It is site_config.json
# verbatim -- db_password and encryption_key in plaintext -- and must not sit
# in a third party's bucket next to the dump it unlocks. With a passphrase set,
# 1 copies it too (encrypted), which makes the archive self-contained.
#OFFSITE_INCLUDE_SITE_CONFIG=0

# Delete dailies at the destination once they are this many days old. Off (0)
# by default, and with it unset no delete is ever attempted. Minimum 14. Not
# recommended: bound the archive with lifecycle rules on the bucket instead
# (README.md, "Immutable copies, and how long they are kept") and give this
# host a key that cannot delete. Against such a key a prune is reported once
# as delegated to the lifecycle rules and then not tried again.
#OFFSITE_RETENTION_DAYS=0

# The `backup-offsite` container reports unhealthy when the newest dump at the
# destination is older than this many hours.
#OFFSITE_MAX_AGE_HOURS=28

# A dead-man's switch for the off-host copy, as BACKUP_PING_URL above but a
# separate check: pinged around every hourly run, so a period of 1 hour and a
# grace of 2 suits it.
#OFFSITE_PING_URL=https://hc-ping.com/<another uuid>

# The context window the model is given, and the value CRM Agent Settings'
# context_tokens must agree with. ollama's default is 4096, which silently
# truncates the grounding out of a long Mentor or Assistant prompt -- from the
# head, where the instruction lives -- and still answers 200.
#OLLAMA_CONTEXT_LENGTH=16384

# --- GPU model (optional) ----------------------------------------------------
# Only used by the `gpu-model` profile, which replaces `local-model` on a host
# with an NVIDIA card: MiniCPM-V-4.7-35B-A3B on llama.cpp. For a NEW site, set
# VECTORA_AGENT_BASE_URL=http://llm:8086/v1 and
# VECTORA_AGENT_MODEL=minicpm-v4.7-35b above; on an existing site those do
# nothing -- set them in Settings -> Assistant. Either way set context_tokens
# 16384 there. See deploy/README.md, "A GPU host".
#
# The weights file, where to fetch it if the volume lacks it, and the digest it
# must match before the server starts. Change all three together.
#VECTORA_LLM_FILE=MiniCPM-V-4_7-35B-A3B-Q4_K_M.gguf
#VECTORA_LLM_URL=https://huggingface.co/openbmb/MiniCPM-V-4.7-35B-A3B-gguf/resolve/cf943fbe32f840b20ca05ccc146e7dc72baf9a9b/MiniCPM-V-4_7-35B-A3B-Q4_K_M.gguf
#VECTORA_LLM_SHA256=9ecf91e814d7e9adc64325b1b65f8628a9b1bb8da4f61a92869ca7489bfd888e
#
# CPU threads for the expert layers, which run on the CPU. The physical core
# count of the performance cores is the ceiling; past it the model slows down.
#VECTORA_LLM_THREADS=8
#
# The model name the server answers to. Must equal the assistant's model.
#VECTORA_LLM_ALIAS=minicpm-v4.7-35b
