# Copy to .env beside docker-compose.yml and fill in the secrets.
# Nothing here has a workable default on purpose: a stack that boots with
# guessable credentials is worse than one that refuses to boot.

# The image builds.yml publishes. Three kinds of tag are available:
#
#   v3.2.1      a release. Immutable, because the git tag is. Use this.
#   sha-abc1234 one exact commit. Immutable. Use when running something that
#               is not a release, e.g. verifying a fix before it ships.
#   stable      a moving pointer to the newest main build. Convenient for a
#               scratch environment, wrong for anything a customer touches:
#               two `docker compose pull`s a week apart give you materially
#               different systems and no way to say which one broke.
#
# Required: docker-compose.yml has no default for VECTORA_TAG, so a stack
# cannot drift onto `stable` by omission. Set a release and bump it when you
# upgrade, so the file records what is running.
#
# Check the tag actually has an image before pinning it -- a GitHub release and
# a published image are two separate steps, and v3.2.0 shipped as the first
# without the second. docs/RELEASING.md explains why and how to confirm.
VECTORA_IMAGE=ghcr.io/absolute-insight/simcrm
VECTORA_TAG=v3.13.0

# The site name is also the Host header nginx routes on. Use the real domain.
SITE_NAME=crm.example.com

DB_ROOT_PASSWORD=
ADMIN_PASSWORD=

# Where the frontend listens on the host. Put TLS in front of this — see
# README.md; this stack deliberately does not terminate TLS itself.
#
# The port is bound to loopback by default, so only a reverse proxy on the
# same host can reach it. Set HTTP_BIND_ADDRESS=0.0.0.0 only when the proxy
# (or, for a rehearsal, you) is on another machine — then the plain-HTTP
# frappe port is open to whatever can route to the host, firewall included.
HTTP_BIND_ADDRESS=127.0.0.1
HTTP_PUBLISH_PORT=8080

# --- Local model (optional) --------------------------------------------------
# Only used by the `local-model` compose profile:
#   docker compose --profile local-model up -d
# Without the profile none of this applies and the agent tier talks to whatever
# remote OpenAI-compatible endpoint you configure in CRM Agent Settings — or to
# nothing at all, which is the default and a supported state.

# LFM2.5-2.6B is the model this stack is verified against. Eleven models were
# run through the real client on the injection corpus; this is the only one
# that refused to draft the fraudulent discount (0/7, where every Apache
# candidate confirmed it 7/7). Guided decoding is clean and a warm summary
# returns in ~2.8s on a small GPU.
#
# ⚠ LICENCE: LFM2.5-2.6B ships under LFM1.0, not Apache. Commercial use is
# limited above "annual revenue of 10 million United States dollars". If your
# organisation is above that line, do not run this default -- buy a commercial
# licence from Liquid AI, or move to hardware that can host a larger
# permissively-licensed model. See deploy/README.md, "The model licence, and
# who it binds", for the two supported ways through.
#
# Do not use InternScience/Agents-A1-4B: it connects fine and returns empty
# content, which the agent correctly reports as "unavailable".
#
# Do not use openbmb/MiniCPM5-2B or MiniCPM5-1B either, and not for that reason
# -- both load on this profile and answer quickly (the 2B in 0.7s with
# reasoning off, against the default's 3.3s). They take the planted instruction:
# on the injection corpus the 2B lands 3 of 4 cases with every control arm
# clean, and the 1B confirms the fraudulent 90% discount 3 of 3. The 1B was
# previously listed above for returning empty content; that was the old
# 1024-token budget, not the model. Checked 2026-09-08.
#
# XHToken/Spark-X2.5-4B (Apache-2.0, and otherwise a real candidate) cannot be
# served by this profile at all: ollama pulls it and the first call dies with
# `unknown model architecture: 'spark2_5'`. Checked 2026-09-08; the ollama
# support PR was still open. Do not set it here expecting it to work.
VECTORA_AGENT_MODEL=hf.co/LiquidAI/LFM2.5-2.6B-GGUF:Q4_K_M

# Set to 1 when you bring the profile up, and the site is created with the
# assistant already switched on and pointed at the ollama container. Left at 0
# the tier ships off — the endpoint is still configured, so an admin turning it
# on in Settings -> Assistant has nothing else to fill in.
#
# Both are read exactly once, by after_install when the site is created. They
# do nothing on an existing site: change the endpoint in Settings instead, or
# the deployment would quietly revert an admin's choice on every upgrade.
VECTORA_AGENT_ENABLED=0

# Where the assistant looks for an OpenAI-compatible endpoint. The default is
# the ollama service in this file; point it at your own server (including a
# hosted one) to use that instead, with or without the local-model profile.
VECTORA_AGENT_BASE_URL=http://ollama:11434/v1

# How long ollama keeps weights resident. Short values mean the first rep after
# a quiet period waits for a reload — measured at ~9.5s cold against ~1s warm,
# so this is the difference between "instant" and "did it break?".
OLLAMA_KEEP_ALIVE=24h

# The address range nginx trusts to carry the real client IP in
# X-Forwarded-For. The default covers Docker's private networks, which is where
# a reverse proxy on this host arrives from; set your proxy's address if it
# sits elsewhere. Wrong, and every user shares one rate-limit bucket.
#UPSTREAM_REAL_IP_ADDRESS=172.16.0.0/12

# --- Backups ---------------------------------------------------------------
# The `backup` service takes one every night and prunes to a week (the site's
# keep_backups_for_hours, set to 168 by create-site).

# Hour of the day it runs, container local time.
#BACKUP_HOUR=2

# Where nightly backups are copied off the host, as an rclone destination.
# Empty means local only -- which is a copy, not a backup: it does not survive
# losing the machine. Set this before a customer's data lands. Needs rclone in
# the image and a config the container can read; if it is set and rclone is
# missing, the nightly log says so.
#BACKUP_TARGET=s3:vectora-backups/mbp

# The context window the model is given, and the value CRM Agent Settings'
# context_tokens must agree with. ollama's default is 4096, which silently
# truncates the grounding out of a long Mentor or Assistant prompt -- from the
# head, where the instruction lives -- and still answers 200.
#OLLAMA_CONTEXT_LENGTH=16384
