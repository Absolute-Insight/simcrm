# Copy to .env beside docker-compose.yml and fill in the secrets.
# Nothing here has a workable default on purpose: a stack that boots with
# guessable credentials is worse than one that refuses to boot.

# The image builds.yml publishes on push to main. Pin VECTORA_TAG to a release
# tag for reproducible deploys; "stable" tracks the latest main build.
VECTORA_IMAGE=ghcr.io/absolute-insight/simcrm
VECTORA_TAG=stable

# The site name is also the Host header nginx routes on. Use the real domain.
SITE_NAME=crm.example.com

DB_ROOT_PASSWORD=
ADMIN_PASSWORD=

# Where the frontend listens on the host. Put TLS in front of this — see
# README.md; this stack deliberately does not terminate TLS itself.
HTTP_PUBLISH_PORT=8080

# --- Local model (optional) --------------------------------------------------
# Only used by the `local-model` compose profile:
#   docker compose --profile local-model up -d
# Without the profile none of this applies and the agent tier talks to whatever
# remote OpenAI-compatible endpoint you configure in CRM Agent Settings — or to
# nothing at all, which is the default and a supported state.

# granite-4.0-h-tiny is the model this stack is verified against: guided
# decoding is clean and a warm summary returns in about a second on a small
# GPU. LFM2.5-2.6B also works. Do not use MiniCPM5-1B — it intermittently
# returns empty content, which the agent correctly reports as "unavailable".
VECTORA_AGENT_MODEL=hf.co/ibm-granite/granite-4.0-h-tiny-GGUF:Q4_K_M

# How long ollama keeps weights resident. Short values mean the first rep after
# a quiet period waits for a reload — measured at ~9.5s cold against ~1s warm,
# so this is the difference between "instant" and "did it break?".
OLLAMA_KEEP_ALIVE=24h
