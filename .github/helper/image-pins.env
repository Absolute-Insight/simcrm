# Everything the published image is built from, other than frappe itself
# (scripts/frappe-pin.env) and this repo. Sourced by builds.yml and by
# image-build-inputs.yml, which proves the three still work together on every
# PR rather than at release time.
#
# All three are pinned because builds.yml runs only on a push to main or a tag.
# Anything left floating here moves without anyone choosing it and is first
# noticed during a release, which is the worst moment to discover it.

# frappe_docker supplies the Containerfile that builds/prepare-containerfile.sh
# rewrites. It is third-party source, so it is pinned like the third-party
# actions in builds.yml are. It used to be checked out at main: an upstream edit
# to the Containerfile would then land in the next release untested, and that
# has already happened once -- a `base` stage was added while only the `builder`
# FROM was being rewritten.
#   gh api repos/frappe/frappe_docker/commits/main --jq .sha
FRAPPE_DOCKER_REF=ba450260c52eb1b186fe7ba0bec8b61299bb9037 # main, 2026-08-25

# The builder toolchain (node, python, yarn, wkhtmltopdf) and the runtime base.
# frappe_docker derives both from FRAPPE_BRANCH, and upstream publishes them
# only for its own branch names, so the local branch name our pinned frappe is
# parked on would resolve to frappe/build:pinned -- a tag that does not exist.
# They are a toolchain, not application code, so they are pinned separately.
#
# By digest, not tag: `develop` is a moving pointer. Both are multi-arch indexes
# covering linux/amd64 and linux/arm64 -- pinning a per-architecture manifest
# would break the arm64 half of the build.
#
# Refresh deliberately, and let check-build-toolchain.sh confirm the new pair
# still satisfies the pinned frappe before merging:
#   docker buildx imagetools inspect frappe/build:develop --format '{{.Manifest.Digest}}'
FRAPPE_BUILD_IMAGE=frappe/build@sha256:9d6f54db5635f8c5c10911112dfdeaf29b18c9cfe062f89731d2c591f3730d60 # frappe/build:develop, resolved 2026-08-21
FRAPPE_BASE_IMAGE=frappe/base@sha256:aa470cd87c680914a03c295f443b366bd1930a4f3c4965c18eef427b78db332d # frappe/base:develop, resolved 2026-08-21
